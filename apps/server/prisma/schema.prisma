generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CharacterClass {
  GUARDIAN
}

enum CharacterAvailability {
  AVAILABLE
  IN_ACTIVE_RUN
  AWAY_CALIBRATING
  AWAY_FARMING
  AWAY_REWARD_PENDING
}

enum EquipmentSlot {
  HELMET
  CHEST
  GLOVES
  BOOTS
  MAIN_HAND
  OFF_HAND
  AMULET
  RING_1
  RING_2
}

enum CalibrationState {
  NOT_STARTED
  RUNNING
  VALID
  INVALID
  ACTIVATED
}

enum AwaySessionState {
  ACTIVE
  COMPLETED
  REWARD_PENDING
  CLAIMED
  CANCELLED
}

enum AwayResultState {
  PENDING
  CLAIMED
  REJECTED
}

enum MissionResultState {
  PENDING
  COMPLETED
  CLAIMED
  FAILED
}

enum RewardKind {
  ECONOMY
  AWAY
  MISSION
}

model User {
  id                 String              @id @db.VarChar(128)
  email              String              @unique @db.VarChar(320)
  displayName        String              @default("Viajero") @db.VarChar(64)
  passwordHash       String?             @db.VarChar(256)
  revision           Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  characters         Character[]         @relation("CharacterOwner")
  sessions           Session[]
  characterSelection CharacterSelection?
}

model Session {
  id         String    @id @db.VarChar(128)
  userId     String    @db.VarChar(128)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Character {
  id             String                @id @db.VarChar(128)
  userId         String                @db.VarChar(128)
  name           String                @db.VarChar(64)
  class          CharacterClass
  availability   CharacterAvailability @default(AVAILABLE)
  gold           BigInt                @default(0)
  materials      BigInt                @default(0)
  strength       Int                   @default(10)
  dexterity      Int                   @default(10)
  intelligence   Int                   @default(10)
  vitality       Int                   @default(10)
  lastSeenAt     DateTime              @default(now())
  saveVersion    Int                   @default(1)
  revision       Int                   @default(1)
  createdAt      DateTime              @default(now())
  deletedAt      DateTime?
  updatedAt      DateTime              @updatedAt
  user           User                  @relation("CharacterOwner", fields: [userId], references: [id], onDelete: Restrict)
  inventory      Inventory?
  equipment      Equipment[]
  inventoryItems InventoryItem[]       @relation("InventoryItemOwner")
  skills         CharacterSkill[]
  progress       CharacterProgress?
  calibrations   AwayCalibration[]
  awaySessions   AwaySession[]
  awayResults    AwayResult[]
  missionResults MissionResult[]
  rewardLogs     RewardLog[]
  checkpointReceipts CharacterCheckpointReceipt[]
  selection      CharacterSelection?

  @@unique([id, userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([availability])
}

model CharacterCheckpointReceipt {
  id            String    @id @db.VarChar(128)
  characterId   String    @db.VarChar(128)
  operationId   String    @unique @db.VarChar(128)
  requestHash   String    @db.Char(64)
  schemaVersion Int
  sceneId       String    @db.VarChar(64)
  checkpointId  String    @db.VarChar(128)
  serverState   Json      @default("{}")
  createdAt     DateTime  @default(now())
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@unique([characterId, operationId])
}

model CharacterSelection {
  userId      String    @id @db.VarChar(128)
  characterId String    @db.VarChar(128)
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([characterId, userId])
}

model Inventory {
  id            String          @id @db.VarChar(128)
  characterId   String          @unique @db.VarChar(128)
  capacity      Int             @default(40)
  schemaVersion Int             @default(1)
  revision      Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  character     Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  items         InventoryItem[]

  @@unique([id, characterId])
}

model InventoryItem {
  id             String     @id @db.VarChar(128)
  characterId    String     @db.VarChar(128)
  inventoryId    String     @db.VarChar(128)
  definitionId   String     @db.VarChar(128)
  rarity         String     @default("common") @db.VarChar(32)
  itemPower      Int        @default(0)
  favorite       Boolean    @default(false)
  affixes        Json       @default("[]")
  generationData Json       @default("{}")
  quantity       Int        @default(1)
  itemData       Json       @default("{}")
  revision       Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  inventory      Inventory  @relation(fields: [inventoryId, characterId], references: [id, characterId], onDelete: Cascade)
  character      Character  @relation("InventoryItemOwner", fields: [characterId], references: [id], onDelete: Cascade)
  equipment      Equipment?

  @@unique([id, characterId])
  @@index([inventoryId])
  @@index([characterId, inventoryId])
}

model Equipment {
  id              String        @id @db.VarChar(128)
  characterId     String        @db.VarChar(128)
  inventoryItemId String        @unique @db.VarChar(128)
  slot            EquipmentSlot
  revision        Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId, characterId], references: [id, characterId], onDelete: Restrict)

  @@unique([characterId, slot])
  @@unique([inventoryItemId, characterId])
  @@index([characterId])
}

model CharacterSkill {
  id          String    @id @db.VarChar(128)
  characterId String    @db.VarChar(128)
  abilityId   String    @db.VarChar(128)
  level       Int       @default(1)
  unlocked    Boolean   @default(true)
  equipped    Boolean   @default(false)
  barSlot     Int?
  revision    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, abilityId])
  @@index([characterId])
}

model CharacterProgress {
  id              String    @id @db.VarChar(128)
  characterId     String    @unique @db.VarChar(128)
  level           Int       @default(1)
  experience      BigInt    @default(0)
  attributePoints Int       @default(0)
  schemaVersion   Int       @default(1)
  state           Json      @default("{}")
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model AwayCalibration {
  id                   String           @id @db.VarChar(128)
  characterId          String           @db.VarChar(128)
  state                CalibrationState @default(NOT_STARTED)
  zoneId               String           @db.VarChar(128)
  difficulty           String           @db.VarChar(32)
  buildFingerprint     String           @db.VarChar(256)
  calculationSeed      String           @db.VarChar(256)
  validDurationSeconds Int              @default(0)
  buildSnapshot        Json             @default("{}")
  buildVersion         String           @default("1") @db.VarChar(64)
  startedAt            DateTime?
  completedAt          DateTime?
  metrics              Json             @default("{}")
  normalizedRates      Json             @default("{}")
  invalidReason        String?          @db.VarChar(160)
  balanceVersion       String           @default("1") @db.VarChar(64)
  dataVersion          String           @default("1") @db.VarChar(64)
  formulaVersion       String           @default("1") @db.VarChar(64)
  schemaVersion        Int              @default(1)
  revision             Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  character            Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sessions             AwaySession[]

  @@index([characterId, state])
}

model AwaySession {
  id                    String           @id @db.VarChar(128)
  characterId           String           @db.VarChar(128)
  calibrationId         String           @db.VarChar(128)
  activationOperationId String           @unique @db.VarChar(128)
  state                 AwaySessionState @default(ACTIVE)
  startedAt             DateTime         @default(now())
  endedAt               DateTime?
  maxDurationSeconds    Int              @default(28800)
  snapshot              Json             @default("{}")
  zoneId                String           @default("unknown") @db.VarChar(128)
  difficulty            String           @default("normal") @db.VarChar(32)
  calculationSeed       String           @default("pending") @db.VarChar(256)
  schemaVersion         Int              @default(1)
  activeMarker          String?          @default("active") @db.VarChar(16)
  revision              Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  character             Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  calibration           AwayCalibration  @relation(fields: [calibrationId], references: [id], onDelete: Restrict)
  result                AwayResult?

  @@unique([characterId, activeMarker])
  @@index([characterId, state])
  @@index([calibrationId])
}

model AwayResult {
  id               String          @id @db.VarChar(128)
  characterId      String          @db.VarChar(128)
  sessionId        String          @unique @db.VarChar(128)
  operationId      String          @unique @db.VarChar(128)
  state            AwayResultState @default(PENDING)
  startedAt        DateTime        @default(now())
  endedAt          DateTime        @default(now())
  elapsedSeconds   Int             @default(0)
  computedSeconds  Int             @default(0)
  discardedSeconds Int             @default(0)
  efficiency       Float           @default(0)
  rewards          Json            @default("{}")
  balanceVersion   String          @default("1") @db.VarChar(64)
  dataVersion      String          @default("1") @db.VarChar(64)
  formulaVersion   String          @default("1") @db.VarChar(64)
  schemaVersion    Int             @default(1)
  claimedAt        DateTime?
  result           Json            @default("{}")
  revision         Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  character        Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  session          AwaySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([characterId, state])
}

model MissionResult {
  id             String             @id @db.VarChar(128)
  characterId    String             @db.VarChar(128)
  missionId      String             @db.VarChar(128)
  operationId    String             @unique @db.VarChar(128)
  state          MissionResultState @default(PENDING)
  difficulty     String             @default("normal") @db.VarChar(32)
  outcome        String             @default("pending") @db.VarChar(32)
  progress       Json               @default("{}")
  rewardsClaimed Boolean            @default(false)
  balanceVersion String             @default("1") @db.VarChar(64)
  dataVersion    String             @default("1") @db.VarChar(64)
  schemaVersion  Int                @default(1)
  result         Json               @default("{}")
  revision       Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  character      Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, state])
}

model RewardLog {
  id                     String     @id @db.VarChar(128)
  characterId            String     @db.VarChar(128)
  operationId            String     @unique @db.VarChar(128)
  requestHash            String     @db.VarChar(128)
  kind                   RewardKind
  goldDelta              BigInt     @default(0)
  materialsDelta         BigInt     @default(0)
  experienceDelta        BigInt     @default(0)
  goldBalanceAfter       BigInt     @default(0)
  materialsBalanceAfter  BigInt     @default(0)
  experienceBalanceAfter BigInt     @default(0)
  source                 String     @default("unknown") @db.VarChar(64)
  sourceId               String     @default("unknown") @db.VarChar(128)
  balanceVersion         String     @default("1") @db.VarChar(64)
  dataVersion            String     @default("1") @db.VarChar(64)
  formulaVersion         String     @default("1") @db.VarChar(64)
  schemaVersion          Int        @default(1)
  payload                Json       @default("{}")
  revision               Int        @default(1)
  createdAt              DateTime   @default(now())
  character              Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@index([characterId, requestHash])
}
