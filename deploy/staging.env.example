# Copy to a secret-managed environment file before starting staging.
NODE_ENV=production
SERVER_STATUS=available
SERVER_HOST=0.0.0.0

POSTGRES_DB=brecha_staging
POSTGRES_USER=brecha_staging
POSTGRES_PASSWORD=replace-with-a-secret
STAGING_DB_PORT=5433
STAGING_API_PORT=3002
STAGING_WEB_PORT=8080

# These are public origins/URLs, not secrets. They must match the deployed DNS/TLS names.
STAGING_WEB_ORIGIN=http://127.0.0.1:8080
STAGING_API_URL=http://127.0.0.1:3002
STAGING_WEB_URL=http://127.0.0.1:8080
STAGING_API_HEALTH_URL=http://127.0.0.1:3002

# Used by manual Prisma commands outside Compose; keep credentials in the secret manager.
DATABASE_URL=postgresql://brecha_staging:replace-with-a-secret@127.0.0.1:5433/brecha_staging

# Required only with `--profile tls` and real DNS records.
STAGING_WEB_HOST=staging.example.com
STAGING_API_HOST=api.staging.example.com
